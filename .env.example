# AI Story Creator Pro - 环境变量配置示例
# 复制此文件为 .env 并填入你的真实密钥

# ============================================
# 故事生成API配置
# ============================================

# 当前使用的API预设
API_PRESET='DeepSeek'

# 故事模版（可选）
STORY_TEMPLATE_KEY='zhihu_realistic'

# 模版策略（可选）：fixed / rotate / shuffle
STORY_TEMPLATE_STRATEGY='fixed'

# 创新模式（可选）：stable / blend / wild
STORY_CREATIVITY_MODE='blend'

# 是否仅用模型（1=仅模型, 0=启用知识库检索）
MODEL_ONLY='0'

# RAG 检索最低相似度阈值（0-1）
RAG_MIN_SCORE='0.12'

# DeepSeek配置
STORY_DeepSeek_KEY='your-deepseek-api-key-here'
STORY_DeepSeek_BASE_URL='https://api.deepseek.com/v1'
STORY_DeepSeek_MODEL='deepseek-chat'

# 兼容旧配置（可选）
# DEEPSEEK_API_KEY='your-deepseek-api-key-here'
# DEEPSEEK_BASE_URL='https://api.deepseek.com/v1'
# DEEPSEEK_MODEL='deepseek-chat'

# ModelScope配置（可选）
STORY_mota_KEY='your-modelscope-api-key-here'
STORY_mota_BASE_URL='https://api-inference.modelscope.cn/v1'
STORY_mota_MODEL='Qwen/Qwen3-235B-A22B-Thinking-2507'

# ============================================
# 图片生成API配置
# ============================================

# 当前使用的图片API预设
IMG_API_PRESET='V-API-DALL-E-2'

# 图片尺寸
IMG_SIZE='1024x1024'

# V-API配置（DALL-E）
IMG_V_API_DALL_E_2_KEY='your-v-api-key-here'
IMG_V_API_DALL_E_2_BASE_URL='https://api.gpt.ge/v1'
IMG_V_API_DALL_E_2_MODEL='dall-e-3'

# 腾讯混元配置（可选）
IMG_腾讯混元_KEY='your-tencent-secret-id-here'
IMG_腾讯混元_SECRET_KEY='your-tencent-secret-key-here'
IMG_腾讯混元_BASE_URL='https://hunyuan.tencentcloudapi.com'
IMG_腾讯混元_MODEL='hunyuan-turbo'

# ============================================
# 辅助功能API配置
# ============================================

# 分镜生成使用的API
ASSIST_SHOT_GEN_API='mota'

# 描述生成使用的API
ASSIST_DESC_GEN_API='mota'

# 大纲生成使用的API
STORY_OUTLINE_GEN_API='DeepSeek'

# 故事生成使用的API
STORY_STORY_GEN_API='DeepSeek'
